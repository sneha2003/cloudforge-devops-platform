{
  email {$ACME_EMAIL}
  admin off
}

(secure_site) {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }
  log {
    output stdout
    format json
  }
}

{$WORKBOARD_DOMAIN} {
  import secure_site
  reverse_proxy sample-service:8100
}

{$CLOUDFORGE_DOMAIN} {
  import secure_site
  reverse_proxy dashboard:8080
}
