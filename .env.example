CLOUDFORGE_ENV=local
CLOUDFORGE_VERSION=dev
CLOUDFORGE_DATABASE_PATH=/data/cloudforge.db
CLOUDFORGE_OPERATOR_TOKEN=replace-with-a-long-random-value
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-sharing
# Deployment scripts set this to an immutable WorkBoard image.
CLOUDFORGE_API_IMAGE=cloudforge-api:local
CLOUDFORGE_SAMPLE_IMAGE=cloudforge-workboard:local
CLOUDFORGE_FORCE_NOT_READY=false
# Azure HTTPS overlay only (point both DNS records at the VM)
WORKBOARD_DOMAIN=workboard.example.com
CLOUDFORGE_DOMAIN=cloudforge.example.com
ACME_EMAIL=you@example.com

